# ---- Firefly III ----
# Exactly 32 characters. Make one with: head -c 24 /dev/urandom | base64
FIREFLY_APP_KEY=
# The address you open Firefly at (change it when you put this online)
FIREFLY_PUBLIC_URL=http://localhost:8080
SITE_OWNER=you@example.com
TZ=Asia/Singapore
DB_PASSWORD=
# Exactly 32 characters, used by the daily job
STATIC_CRON_TOKEN=

# Create this AFTER Firefly is running:
# Firefly > Options > Profile > OAuth > Personal Access Tokens > Create new token
FIREFLY_TOKEN=

# ---- Receipt scanner ----
# From https://platform.claude.com (API keys)
ANTHROPIC_API_KEY=
RECEIPT_MODEL=claude-opus-5-5
# A long random password. The iPhone Shortcut and the web page send it.
RECEIPTS_API_KEY=
# Which Firefly asset account pays, by payment method or currency.
# The names must match accounts you created in Firefly.
ACCOUNT_MAP={"Alipay": "Alipay", "WeChat Pay": "WeChat Pay", "CNY": "Alipay", "SGD": "DBS"}
DEFAULT_ACCOUNT=DBS
DEFAULT_CURRENCY=SGD
