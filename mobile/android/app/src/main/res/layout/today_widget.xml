<?xml version="1.0" encoding="utf-8"?>
<!-- The Home Screen widget: today's next three things to do. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/today_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/today_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/today_widget_name"
            android:textColor="@color/today_green"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/today_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/today_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/today_task1"
        style="@style/TodayWidgetTask"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/today_task2"
        style="@style/TodayWidgetTask" />

    <TextView
        android:id="@+id/today_task3"
        style="@style/TodayWidgetTask" />

    <TextView
        android:id="@+id/today_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:text="@string/today_widget_open"
        android:textColor="@color/today_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/today_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/today_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/today_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="@color/today_muted"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
